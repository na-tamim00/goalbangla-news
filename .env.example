# =========================================================
# VERCEL DEPLOYMENT (Backend API & Database)
# =========================================================
# PostgreSQL Database (Supabase / Neon / Render / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/goalbangla"

# Admin Authentication Secret (32+ character random string)
JWT_SECRET="goalbangla-super-secret-jwt-key-change-in-production-2026"

# Sports Data API (RapidAPI - API-Football)
# Required for genuine live scores. Without it, the site displays clearly marked demo data.
RAPIDAPI_KEY=""
RAPIDAPI_HOST="api-football-v1.p.rapidapi.com"
FOOTBALL_DATA_ORG_KEY=""

# Canonical Site URL
NEXT_PUBLIC_SITE_URL="https://goalbangla.netlify.app"

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=""

# Transactional email (required in production for newsroom invitations)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="GoalBangla Newsroom <news@goalbangla.com>"

# Persistent media storage (required in production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
