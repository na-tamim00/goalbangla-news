# =========================================================
# VERCEL DEPLOYMENT (Backend API & Database)
# =========================================================
# PostgreSQL Database (Supabase / Neon / Render / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/goalbangla"

# Admin Authentication Secret (32+ character random string)
JWT_SECRET="goalbangla-super-secret-jwt-key-change-in-production-2026"

# Sports Data API (RapidAPI - API-Football)
# Leave empty to use the built-in realistic football simulator & BPL provider
RAPIDAPI_KEY=""
RAPIDAPI_HOST="api-football-v1.p.rapidapi.com"
FOOTBALL_DATA_ORG_KEY=""

# Canonical Site URL
NEXT_PUBLIC_SITE_URL="https://goalbangla.netlify.app"

# =========================================================
# NETLIFY DEPLOYMENT (Frontend UI)
# =========================================================
# Set this in Netlify Environment Variables to connect to your Vercel backend
BACKEND_VERCEL_URL="https://your-goalbangla-api.vercel.app"
NEXT_PUBLIC_API_URL="https://your-goalbangla-api.vercel.app"

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=""
